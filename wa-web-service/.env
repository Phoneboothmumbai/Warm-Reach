# WhatsApp Web Service Configuration

# Redis connection (for session storage)
REDIS_URL=redis://localhost:6379

# FastAPI backend URL (for callbacks)
BACKEND_URL=http://localhost:8001

# Service port
PORT=3001

# Logging level
LOG_LEVEL=info

# Session timeout in hours
SESSION_TIMEOUT_HOURS=24

# Max reconnection attempts
MAX_RECONNECT_ATTEMPTS=5

# Rate limiting (messages per hour for WhatsApp Web - stricter than Cloud API)
WA_WEB_RATE_LIMIT_HOUR=20
